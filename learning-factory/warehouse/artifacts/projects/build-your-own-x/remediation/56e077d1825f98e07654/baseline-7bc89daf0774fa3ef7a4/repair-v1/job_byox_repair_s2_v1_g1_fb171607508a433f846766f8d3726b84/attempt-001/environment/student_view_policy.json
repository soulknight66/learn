{
  "schema_version": 1,
  "exposure_model": "explicit-root-allowlist",
  "root_files": [
    "README.md",
    "AGENTS.md",
    "MANIFEST.yaml",
    "REQUIREMENTS.md",
    "CONCEPTS.md",
    "DESIGN_QUESTIONS.md"
  ],
  "root_directories": [
    "starter",
    "public_tests",
    "environment"
  ],
  "forbidden_path_components": [
    "sealed",
    "reference",
    "reference_tests",
    "hidden_tests",
    "solution",
    "solutions",
    "answers"
  ],
  "allowed_entry_types": [
    "directory",
    "regular_file"
  ],
  "independent_materialization_validation": "REQUIRED"
}
